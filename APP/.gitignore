# ============================================
# 🌸 Masajes Flores de Bach - Frontend (APP)
# GitIgnore para proyecto React/Vite/Node.js
# ============================================

# Dependencias
node_modules/
package-lock.json
yarn.lock

# Compilación / build
dist/
build/
*.log

# Archivos de entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache y temporales
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vscode/
.idea/
.DS_Store
Thumbs.db

# Archivos del sistema
*.swp
*.swo
*.tmp
*.bak

# Archivos de testing
coverage/
jest-cache/
jest-test-results.json

# Editor / OS
*.sublime-workspace
*.sublime-project
*.iml

# Local settings
*.local
*.cache/
.cache/
.tmp/

# Otros innecesarios
*.tgz
*.tar.gz
*.zip

# ============================================
# Fin del archivo .gitignore
# ============================================
